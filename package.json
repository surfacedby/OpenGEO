{
  "name": "opengeo",
  "version": "0.1.0-beta.6",
  "private": true,
  "type": "module",
  "description": "Open-source generative engine optimization (GEO) workspace: track AI visibility, mentions and citations, audit your site and create evidence-based content.",
  "license": "MIT",
  "author": {
    "name": "SurfacedBy",
    "url": "https://surfacedby.com"
  },
  "homepage": "https://github.com/surfacedby/OpenGEO",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "tsx server/main.ts",
    "web": "vite --host 127.0.0.1",
    "build": "node scripts/sync-identity.mjs && tsc --noEmit && vite build && tsup server/main.ts server/cli.ts server/mcp.ts --format esm --platform node --out-dir dist-server --clean --external better-sqlite3",
    "start": "node dist-server/main.js",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:browser": "tsx --test --test-concurrency=1 tests/*.e2e.ts",
    "desktop": "electron desktop/main.cjs",
    "package:desktop": "npm run build && node scripts/prepare-browser.mjs && node scripts/prepare-native.mjs && electron-builder --publish never",
    "cli": "tsx server/cli.ts",
    "mcp": "tsx server/mcp.ts",
    "check:public": "node scripts/public-surface.mjs",
    "audit:release": "node scripts/public-surface.mjs && node scripts/release-audit.mjs",
    "audit:source": "node scripts/public-surface.mjs && node scripts/release-audit.mjs --source",
    "audit:canaries": "node scripts/scanner-canaries.mjs",
    "audit:deps": "node scripts/dependency-audit.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@fontsource/inter": "^5.2.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2",
    "cron-parser": "^5.4.0",
    "electron-updater": "6.8.11",
    "fastify": "^5.12.6",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^7.30.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.0.0",
    "opentype.js": "^1.3.4",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7"
  },
  "build": {
    "appId": "org.opengeo.desktop",
    "productName": "OpenGEO",
    "copyright": "Copyright (c) 2026 OpenGEO contributors",
    "asar": true,
    "npmRebuild": false,
    "extraResources": [
      {
        "from": ".browser-runtime",
        "to": "browsers",
        "filter": [
          "**/*",
          "!**/.links/**"
        ]
      }
    ],
    "files": [
      "desktop/**",
      "assets/**",
      "dist/**",
      "dist-server/**",
      "package.json",
      "!node_modules/better-sqlite3/bin/**",
      "!node_modules/**/docs/**",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/zod/src/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "OpenGEO-${version}-windows-${arch}.${ext}",
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "include": "desktop/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "surfacedby",
      "repo": "OpenGEO"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/app-icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/app-icon.png"
    }
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "minimatch@>=7 <11.0.4": "11.0.4"
  },
  "main": "desktop/main.cjs"
}
